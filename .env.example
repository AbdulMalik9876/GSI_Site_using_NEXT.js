# Copy to .env.local for local dev; on Vercel add these under Settings > Environment Variables.
# Cloudinary (image uploads, used by pages/api/upload.js - server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Google Maps (map on the site - public, restrict it to your domain in Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
